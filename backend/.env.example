# ============================================================
# LinguistBridge — Backend environment variables
# Copy this file to backend/.env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ── Application ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://linguistbridge:linguistbridge_secret@localhost:5432/linguistbridge

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://:redis_secret@localhost:6379

# ── Auth (min 32 chars each) ─────────────────────────────────
JWT_SECRET=replace_with_a_minimum_32_character_random_secret
JWT_REFRESH_SECRET=replace_with_another_32_character_random_secret

# ── CORS ────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
